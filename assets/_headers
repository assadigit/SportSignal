# Static asset cache policy (Workers Static Assets).
# Fonts + favicons are effectively immutable between deploys — a week of
# freshness with must-revalidate fallback keeps non-SW visitors fast too.
/fonts/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

# v13.6 extracted page assets — filename-versioned, safe to cache immutably
# for a year (bump the filename on change).
/core-13.6.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.6.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.6.css
  Cache-Control: public, max-age=31536000, immutable
