# Static asset cache policy (Workers Static Assets).
# Fonts + favicons are effectively immutable between deploys — a week of
# freshness with must-revalidate fallback keeps non-SW visitors fast too.
/fonts/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

# v13.6 extracted page assets — filename-versioned, safe to cache immutably
# for a year (bump the filename on change).
/core-13.8.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.8.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.8.css
  Cache-Control: public, max-age=31536000, immutable

/public-13.13.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og/default.png
  Cache-Control: public, max-age=86400

# v14.0.2-cachefix: public-13.14.js was edited IN PLACE across the SEO
# phase-6 window while keeping its immutable 1-year header — browsers that
# fetched it mid-window pinned the pre-fix build in their HTTP cache, which
# a SW-cache bump CANNOT evict. The fixed build is renamed to public-13.15.js
# (a new URL is a guaranteed cache miss everywhere); 13.14 stays listed for
# any stale HTML that still references it.
# v13.57-uniqueregions: 13.15 → 13.16 rename. The homepage JS layout engine
# (WIDE_RAIL/WIDE_ORDER) needed to learn about the new #statsCard (it goes
# in the side column below cupsCard); editing an immutable asset in place is
# forbidden, so the fixed build is public-13.16.{js,css}. SW cache bumped
# v18 → v19 to evict.
# v13.58-herofix: 13.16 → 13.17 rename. Hero countdown made non-clickable
# (noLink option in spotItemNode) + timezone label added below the kickoff
# time + WIDE_ORDER stats moved to end (mobile last section). SW v19 → v20.
/public-13.17.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.17.css
  Cache-Control: public, max-age=31536000, immutable

/public-13.16.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.16.css
  Cache-Control: public, max-age=31536000, immutable

/public-13.15.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.14.js
  Cache-Control: public, max-age=0, must-revalidate

