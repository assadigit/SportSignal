# Static asset cache policy (Workers Static Assets).
# Fonts + favicons are effectively immutable between deploys — a week of
# freshness with must-revalidate fallback keeps non-SW visitors fast too.
/fonts/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

