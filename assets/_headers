# Static asset cache policy (Workers Static Assets).
# Fonts + favicons are effectively immutable between deploys — a week of
# freshness with must-revalidate fallback keeps non-SW visitors fast too.
/fonts/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon-16x16.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

# v13.6 extracted page assets — filename-versioned, safe to cache immutably
# for a year (bump the filename on change — the rename-on-edit rule).
#
# v13.72-deadweight: the historical version pins are GONE. Until this
# release, _headers carried immutable pins for every retired
# public-13.8…13.22 pair (and core-13.8.js) — ~1.1 MB of orphaned files
# referenced by no served HTML, kept "for stale HTML clients". Three SW
# cache generations (v25→v27) have evicted every client that could still
# hold such HTML, and the same prune was already done once before (v13.29
# removed core-13.6/public-13.6/public-13.8.css). Only the LIVE versions
# are pinned now; the rename history lives in CHANGELOG.md + git.
/core-13.10.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.26.js
  Cache-Control: public, max-age=31536000, immutable

/public-13.23.css
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/og/default.png
  Cache-Control: public, max-age=86400

/hero-poster.jpg
  Cache-Control: public, max-age=604800

# v14.0.7-bingauth: Bing Webmaster Tools site-auth file (B-01). Bing fetches
# the EXACT mixed-case URL /BingSiteAuth.xml verbatim — Static Assets serves
# it before the worker runs, so the R-08 lowercase redirect never touches it.
# (A code-side fallback with the same bytes lives in src/seo/files.ts.)
/BingSiteAuth.xml
  Cache-Control: public, max-age=86400

# v13.99-uclgif: TELEGRAM BOT ASSET — DO NOT DELETE. assets/bot/ucl-night.gif
# is the UCL night GIF the bot sends ahead of Champions League evenings
# (preview) and night results (digest-night). Served at
# https://sportsignal.ir/bot/ucl-night.gif → Telegram uploads it once,
# caches it as a file_id (KV ucl_gif_fileid_v1) and reuses that. NOT
# immutable on purpose: the owner may replace the GIF in place (the bot's
# 90-day file_id TTL eventually picks up the new file; clear the KV key to
# force an immediate re-upload).
/bot/ucl-night.gif
  Cache-Control: public, max-age=86400

# v13.114-stickers: TELEGRAM BOT ASSETS — the league-logo sticker sources
# (512×512 transparent PNGs, ≤512KB each). The Telegram pack
# (t.me/addstickers/sportsignal_leagues_by_SportSignalAlertsBot) was built
# from these ONCE by scripts/make-sticker-pack.js; the worker sends by
# cached file_id and never touches these files. Served so the pack can be
# re-built/re-fetched at any time (not immutable: the owner may replace a
# logo in place — re-run make-sticker-pack.js --recreate to rebuild).
/stickers/*
  Cache-Control: public, max-age=86400

