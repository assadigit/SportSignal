{
  "compilerOptions": {
    "target": "es2021",
    "allowImportingTsExtensions": true,
    "lib": [
      "es2021"
    ],
    "module": "es2022",
    "moduleResolution": "node",
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}